{
    "name": "vldmr-k/sylius-viewed-products-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "viewed products",
        "recently viewed products"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Vldmrk\\SyliusViewedProductsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Vldmrk\\SyliusViewedProductsPlugin\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    }
}
